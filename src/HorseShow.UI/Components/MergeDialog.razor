<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Results and aliases from the others move to the one you keep. The others are deleted. This cannot be undone.
        </MudText>
        <MudRadioGroup T="int" @bind-Value="_keepId">
            @foreach (var o in Options)
            {
                <MudRadio T="int" Value="o.Id">@o.Name <span class="mud-text-secondary">(@o.ResultCount results)</span></MudRadio>
            }
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialog.Close(DialogResult.Ok(_keepId))" data-testid="merge-confirm">Merge</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public sealed record Option(int Id, string Name, int ResultCount);

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public List<Option> Options { get; set; } = [];

    private int _keepId;

    protected override void OnInitialized() => _keepId = Options.OrderByDescending(o => o.ResultCount).First().Id;
}
