@inject ParticipantsViewService Participants

<MudAutocomplete T="NameOption" Value="Value" ValueChanged="ValueChanged" Label="@Label"
                 SearchFunc="Search" ToStringFunc="@(o => o?.Name ?? string.Empty)"
                 CoerceText="false" CoerceValue="false" ResetValueOnEmptyText="true"
                 MinCharacters="1" MaxItems="12" DebounceInterval="150" Dense="@Dense" Margin="@Margin"
                 Variant="@Variant" Clearable="true" ShowProgressIndicator="true" SelectValueOnTab="true"
                 Disabled="@Disabled" Immediate="true" @ref="_auto">
    <ItemTemplate Context="o">
        @if (o.IsNew)
        {
            <MudText Typo="Typo.body2" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="mr-1" />Create "@o.Name"
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.body2">@o.Name</MudText>
        }
    </ItemTemplate>
</MudAutocomplete>

@code {
    public enum Kind { Rider, Horse }

    [Parameter] public Kind For { get; set; } = Kind.Rider;
    [Parameter] public NameOption? Value { get; set; }
    [Parameter] public EventCallback<NameOption?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Dense { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;

    private MudAutocomplete<NameOption> _auto = default!;

    public ValueTask FocusAsync() => _auto.FocusAsync();

    private Task<IEnumerable<NameOption>> Search(string text, CancellationToken ct)
        => For == Kind.Rider ? Participants.SearchRiderOptionsAsync(text, ct) : Participants.SearchHorseOptionsAsync(text, ct);
}
