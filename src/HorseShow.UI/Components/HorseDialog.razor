<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="Model.Name" Label="Name" Required="true" RequiredError="Name is required" AutoFocus="true" />
            <MudTextField @bind-Value="Model.Owner" Label="Owner" Class="mt-2" />
            <MudTextField @bind-Value="Model.RegistrationNumber" Label="Registration #" Class="mt-2" />
            <MudTextField @bind-Value="Model.Notes" Label="Notes" Lines="2" Class="mt-2" />
            <AliasEditor Aliases="Model.Aliases" Class="mt-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public HorseEdit Model { get; set; } = new();

    private MudForm _form = default!;

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (_form.IsValid)
        {
            Dialog.Close(DialogResult.Ok(Model));
        }
    }

    private void Cancel() => Dialog.Cancel();
}
