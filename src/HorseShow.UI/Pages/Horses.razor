@page "/horses"
@inject ParticipantsViewService Participants
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="d-flex align-center mb-4 gap-3 flex-wrap">
    <MudText Typo="Typo.h4">Horses</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_search" Placeholder="Search" Immediate="true" DebounceInterval="200" OnDebounceIntervalElapsed="LoadAsync"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width: 280px" />
    <MudSwitch T="bool" @bind-Value="_includeArchived" @bind-Value:after="LoadAsync" Label="Show archived" Color="Color.Primary" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Create" data-testid="new-horse">New horse</MudButton>
</div>

<MudTable T="HorseRow" Items="_rows" Hover="true" Dense="true" Loading="_rows is null">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Owner</MudTh>
        <MudTh>Reg #</MudTh>
        <MudTh>Also known as</MudTh>
        <MudTh Style="text-align:right">Results</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">
            @context.Horse.Name
            @if (context.Horse.IsArchived) { <MudChip T="string" Size="Size.Small" Class="ml-2">archived</MudChip> }
        </MudTd>
        <MudTd DataLabel="Owner">@context.Horse.Owner</MudTd>
        <MudTd DataLabel="Reg #">@context.Horse.RegistrationNumber</MudTd>
        <MudTd DataLabel="Also known as" Class="mud-text-secondary">@string.Join(", ", context.Horse.Aliases.Select(a => a.Alias).Where(a => a != HorseShow.Core.Text.NameNormalizer.Normalize(context.Horse.Name)))</MudTd>
        <MudTd DataLabel="Results" Style="text-align:right">@context.ResultCount</MudTd>
        <MudTd Style="white-space: nowrap; text-align: right">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Edit(context.Horse)" />
            <MudIconButton Icon="@(context.Horse.IsArchived ? Icons.Material.Filled.Unarchive : Icons.Material.Filled.Archive)" Size="Size.Small"
                           OnClick="() => ToggleArchived(context.Horse)" title="@(context.Horse.IsArchived ? "Unarchive" : "Archive")" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Disabled="context.ResultCount > 0" OnClick="() => Delete(context.Horse)"
                           title="@(context.ResultCount > 0 ? "Has results; archive instead" : "Delete")" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="mud-text-secondary">No horses yet. They are created automatically when you enter results, or add one here.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<HorseRow>? _rows;
    private string? _search;
    private bool _includeArchived;
    private static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _rows = await Participants.ListHorsesAsync(_includeArchived, _search);

    private async Task Create() => await EditAsync(new HorseEdit(), "New horse");

    private async Task Edit(Horse horse) => await EditAsync(HorseEdit.From(horse), "Edit horse");

    private async Task EditAsync(HorseEdit model, string title)
    {
        var dialog = await DialogService.ShowAsync<HorseDialog>(title, new DialogParameters<HorseDialog> { { x => x.Model, model } }, Options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: HorseEdit edit })
        {
            try
            {
                await Participants.SaveHorseAsync(edit);
                await LoadAsync();
            }
            catch (InvalidOperationException ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
    }

    private async Task ToggleArchived(Horse horse)
    {
        await Participants.SetHorseArchivedAsync(horse.Id, !horse.IsArchived);
        await LoadAsync();
    }

    private async Task Delete(Horse horse)
    {
        var ok = await DialogService.ShowMessageBoxAsync($"Delete {horse.Name}?", "This cannot be undone.", yesText: "Delete", cancelText: "Keep");
        if (ok != true) return;
        try
        {
            await Participants.DeleteHorseAsync(horse.Id);
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }
}
