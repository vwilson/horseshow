@page "/"
@implements IDisposable
@inject DashboardViewService Dashboard
@inject ActiveSeasonService Active
@inject NavigationManager Nav

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard</MudText>

@if (_summary is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_summary.ActiveSeason is null)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="0" Outlined="true">
        <MudIcon Icon="@Icons.Material.Outlined.EmojiEvents" Style="font-size: 4rem;" Color="Color.Primary" />
        <MudText Typo="Typo.h5" Class="mt-4">No active season yet</MudText>
        <MudText Typo="Typo.body1" Class="mt-2 mud-text-secondary" Align="Align.Center">
            Create a season to start recording shows and results. Importing by paste or file comes in Phase 3.
        </MudText>
        <MudButton Href="seasons" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6"
                   StartIcon="@Icons.Material.Filled.Add">Create a season</MudButton>
    </MudPaper>
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Outlined="true" Elevation="0">
                <MudCardContent>
                    <MudText Typo="Typo.overline">Active season</MudText>
                    <MudText Typo="Typo.h5">@_summary.ActiveSeason.Name</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="4" sm="6" md="3">
            <MudCard Outlined="true" Elevation="0">
                <MudCardContent>
                    <MudText Typo="Typo.overline">Shows</MudText>
                    <MudText Typo="Typo.h5">@_summary.ShowCount</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="4" sm="6" md="3">
            <MudCard Outlined="true" Elevation="0">
                <MudCardContent>
                    <MudText Typo="Typo.overline">Results</MudText>
                    <MudText Typo="Typo.h5">@_summary.ResultCount</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="4" sm="6" md="3">
            <MudCard Outlined="true" Elevation="0">
                <MudCardContent>
                    <MudText Typo="Typo.overline">Riders · Horses</MudText>
                    <MudText Typo="Typo.h5">@_summary.RiderCount · @_summary.HorseCount</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.h6">Recent shows</MudText>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Href="shows" EndIcon="@Icons.Material.Filled.ArrowForward">All shows</MudButton>
                </div>
                @if (_summary.RecentShows.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No shows yet.</MudText>
                    <MudButton Href="shows" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2" StartIcon="@Icons.Material.Filled.Add">Add the first show</MudButton>
                }
                else
                {
                    <MudList T="ShowRow" Dense="true">
                        @foreach (var s in _summary.RecentShows)
                        {
                            <MudListItem T="ShowRow" Href="@($"shows/{s.Show.Id}")" Icon="@Icons.Material.Filled.EmojiEvents">
                                <div class="d-flex align-center">
                                    <span>@s.Show.Name</span>
                                    <MudSpacer />
                                    <span class="mud-text-secondary">@s.Show.StartDate.ToString("MMM d") · @s.ClassCount classes · @s.ResultCount results</span>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                <MudText Typo="Typo.h6" GutterBottom="true">Quick actions</MudText>
                <MudStack Spacing="1">
                    <MudButton Href="shows" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" FullWidth="true" Style="justify-content: flex-start">New show</MudButton>
                    <MudButton Href="import" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.UploadFile" FullWidth="true" Style="justify-content: flex-start">Import results</MudButton>
                    <MudButton Href="standings" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Leaderboard" FullWidth="true" Style="justify-content: flex-start">Standings</MudButton>
                    <MudButton Href="@($"seasons/{_summary.ActiveSeason.Id}")" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Tune" FullWidth="true" Style="justify-content: flex-start">Season settings</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private DashboardSummary? _summary;

    protected override async Task OnInitializedAsync()
    {
        Active.Changed += OnSeasonChanged;
        _summary = await Dashboard.GetSummaryAsync();
    }

    private void OnSeasonChanged() => InvokeAsync(async () => { _summary = await Dashboard.GetSummaryAsync(); StateHasChanged(); });

    public void Dispose() => Active.Changed -= OnSeasonChanged;
}
